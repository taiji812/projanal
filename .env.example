# Ollama 서버 주소
# - 로컬(Colima): http://192.168.5.2:11434
# - Docker Desktop: http://host.docker.internal:11434
# - K8s 서비스: http://ollama-service:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 사용할 LLM 모델
# 권장: qwen3-coder:30b (코드 이해·JSON 출력 최고 수준)
# 대안: qwen2.5-coder:14b (메모리 여유가 적을 때)
# 기본값: gpt-oss:20b
OLLAMA_MODEL=qwen3-coder:30b

# (선택) Ollama 임베딩 모델 — 미설정 시 all-MiniLM-L6-v2 자동 다운로드
# ANALYSIS_EMBED_MODEL=nomic-embed-text

# 분석 대상 프로젝트 루트 경로 (CLI 모드)
# docker compose run cli 사용 시 /workspace 로 마운트됨
WORKSPACE_PATH=/path/to/project

# 분석 결과 출력 디렉토리
OUTPUT_PATH=./out
